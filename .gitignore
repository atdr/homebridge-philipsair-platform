# Dependencies
node_modules/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Coverage
# (*.lcov does not match lcov.info, which `npm run coverage` writes)
coverage
*.lcov
lcov.info
.nyc_output

# Caches
.eslintcache
.npm
*.tsbuildinfo

# Output of 'npm pack'
*.tgz

# Environment variables
.env*
credentials.json
*.pem
*.key

# Editors and OS
.idea/
.DS_Store

# Temporary folders
tmp/
temp/

# Agent worktrees
# EnterWorktree checks a second copy of this repo out under here. Keeping it out
# of git also keeps it out of the gates that walk the tree; see the matching
# entries in .prettierignore, eslint.config.js, and the check and lint:md scripts.
.claude/worktrees/
