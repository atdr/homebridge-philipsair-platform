#!/usr/bin/env node
'use strict';

//aioairctrl stand-in for a device that accepts the subscription and then never
//notifies. The process stays healthy, so only an idle timer notices; this is
//the silent stall the plugin has to recover from.

const args = process.argv.slice(2);

if (!args.includes('status-observe')) {
  process.exit(2);
}

setInterval(() => {}, 1000);

//exit with the process that spawned it, whose end of the stdin pipe closes
//then, rather than outliving a killed test run (#58)
process.stdin.on('end', () => process.exit(0)).resume();
