#!/usr/bin/env node
'use strict';

//aioairctrl stand-in for a device that is not there at all. A `set` opens a
//session before it sends anything, and against a host that never answers that
//handshake waits indefinitely: no output and no exit, measured on the real CLI
//at 180s and again at 900s. Nothing but the plugin's own cap ends it.

setInterval(() => {}, 1000);

//exit with the process that spawned it, whose end of the stdin pipe closes
//then, rather than outliving a killed test run (#58)
process.stdin.on('end', () => process.exit(0)).resume();
